# Copy to .env if you want to run app.py directly on your host (outside
# Docker) against the Vault container started by `docker compose up vault`.
# docker-compose.yml itself does NOT read this file - it sets these
# explicitly so the whole stack is reproducible from one command.

APP_NAME=Vault Demo App
APP_ENV=development

# Use localhost when running app.py on your host; use the service name
# "vault" when running app.py inside docker-compose's network.
VAULT_ADDR=http://localhost:8200

VAULT_AUTH_METHOD=approle
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Alternative: skip AppRole entirely and use a plain token (fine for local
# experimentation, not how a real service should authenticate).
# VAULT_AUTH_METHOD=token
# VAULT_TOKEN=root

VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=vault-demo
